{
  "uid": "matchforge",
  "title": "matchforge",
  "description": "Connections, queue, matches and logins for the matchforge server.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Connections open",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "matchforge_connections_open" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Players queued",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "matchforge_players_queued" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Matches created (total)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(matchforge_matches_created_total)" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Results applied (total)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "matchforge_results_applied_total" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Matches per second, by mode",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (rate(matchforge_matches_created_total[1m]))",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue wait (seconds)",
      "description": "p50: half of players were matched faster than this. p95: the slow tail.",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(matchforge_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(matchforge_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Logins per second, by result",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(matchforge_logins_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Messages per second",
      "description": "All messages received, and those refused by the per-connection rate limit.",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(matchforge_messages_received_total[1m])",
          "legendFormat": "received"
        },
        {
          "refId": "B",
          "expr": "rate(matchforge_messages_rate_limited_total[1m])",
          "legendFormat": "rate limited"
        }
      ]
    }
  ]
}
